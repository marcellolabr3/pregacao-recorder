[Unit]
Description=pregacao-recorder - estacao de gravacao de pregacoes
Documentation=file:///opt/pregacao-recorder/docs/INSTALACAO.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pregacao-recorder
Environment=PREGACAO_HOME=/opt/pregacao-recorder
EnvironmentFile=-/opt/pregacao-recorder/.env
ExecStart=/usr/bin/python3 -m app.main
Restart=always
RestartSec=5

# Encerramento limpo: para a captura preservando os segmentos.
TimeoutStopSec=30
KillSignal=SIGTERM

# Logs persistentes no journald (alem de logs/pregacao.log)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pregacao

# Durabilidade apos queda de energia
WatchdogSec=0

# endurecimento basico (nao restringe /opt nem /mnt: la ficam as gravacoes)
# ATENCAO: NAO usar NoNewPrivileges aqui. O painel web (e o watchdog) chama
# `sudo -n tailscale ...` para ler status e iniciar a autenticacao; a lista
# fechada fica em /etc/sudoers.d/pregacao-network. Como sudo e binario
# setuid, NoNewPrivileges bloqueia a escalada e a API do Tailscale falharia
# com "the no new privileges flag is set". Os demais endurecimentos valem.
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
