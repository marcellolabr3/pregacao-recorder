<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtWifiCabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="@string/wifi_cabecalho"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtWifiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/wifi_procurando"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listaRedes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:divider="#33000000"
        android:dividerHeight="1dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnProcurar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_procurar" />
</LinearLayout>
