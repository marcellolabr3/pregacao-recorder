<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracao do operador. Dimensoes enxutas de proposito: os 6 campos, o
  botao e o rodape tem que caber numa tela so, para nenhum campo nunca ficar
  escondido acima (o teclado empurrando a lista era o que fazia o "Servico
  remoto" sair de vista).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rolagem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_servidor"
            android:textColor="@color/texto_fraco"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:background="@color/cartao"
            android:hint="@string/cfg_servidor_hint"
            android:importantForAutofill="yes"
            android:inputType="textUri"
            android:padding="10dp"
            android:text="@string/cfg_servidor_padrao"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cfg_porta"
                    android:textColor="@color/texto_fraco"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/campoPorta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/cartao"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:padding="10dp"
                    android:text="@string/cfg_porta_padrao"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cfg_tls"
                    android:textColor="@color/texto_fraco"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/campoTls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cfg_aparelho"
            android:textColor="@color/texto_fraco"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoAparelho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cartao"
            android:hint="@string/cfg_aparelho_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="10dp"
            android:text="@string/cfg_aparelho_padrao"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cfg_usuario"
            android:textColor="@color/texto_fraco"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:background="@color/cartao"
            android:hint="@string/cfg_usuario_hint"
            android:inputType="text"
            android:padding="10dp"
            android:text="@string/cfg_usuario_padrao"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cfg_token"
            android:textColor="@color/texto_fraco"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:background="@color/cartao"
            android:hint="@string/cfg_token_hint"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cfg_salvar"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/cfg_ajuda"
            android:textColor="@color/texto_fraco"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
