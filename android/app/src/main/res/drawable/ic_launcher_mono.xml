<?xml version="1.0" encoding="utf-8"?>
<!--
  Versao monocromatica do icone: o Android 13+ pinta este desenho com a cor
  do tema do lancador. Por isso aqui so ha FORMA (sem cor): um anel e um ponto,
  que continuam legiveis mesmo em uma unica cor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- anel: disco externo com o miolo vazado (fillType evenOdd) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M28,54a26,26 0 1,0 52,0a26,26 0 1,0 -52,0Z M39,54a15,15 0 1,0 30,0a15,15 0 1,0 -30,0Z" />

    <!-- ponto central -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,54a9,9 0 1,0 18,0a9,9 0 1,0 -18,0Z" />
</vector>
