<?xml version="1.0" encoding="utf-8"?>
<!--
  showAsAction="always" (e nao "ifRoom"): com targetSdk 35 o Android 15
  empurra a action bar para tras da barra de status e os itens que ficavam
  no overflow somem junto com ela. Forcados para a barra eles continuam
  visiveis - e e' o caminho que o operador usa para chegar em Configuracoes
  no PC.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/acao_config"
        android:icon="@android:drawable/ic_menu_preferences"
        android:showAsAction="always"
        android:title="@string/btn_config" />
    <item
        android:id="@+id/acao_storage"
        android:icon="@android:drawable/ic_menu_save"
        android:showAsAction="always"
        android:title="@string/btn_storage" />
    <item
        android:id="@+id/acao_drive"
        android:icon="@android:drawable/ic_menu_upload"
        android:showAsAction="always"
        android:title="@string/btn_drive" />
</menu>
