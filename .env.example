# Windows: copie para .env na pasta do projeto. Nunca commitar .env real.
# PIN vazio abre o painel local; PIN admin vazio usa o PIN comum.
PREGACAO_PIN=
PREGACAO_ADMIN_PIN=
# Gere um segredo: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
PREGACAO_SECRET=
# 0.0.0.0 permite rede local; 127.0.0.1 limita ao proprio PC.
PREGACAO_HOST=0.0.0.0
PREGACAO_PORT=8080
PREGACAO_LOG_LEVEL=INFO
# Deixe caminhos vazios para usar config/google_credentials.json e google_token.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=
# Autorizar pelo navegador do PC usando o mesmo host do retorno OAuth.
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback
# Controle remoto MQTT/TLS; nao altera a rede do PC.
PREGACAO_REMOTE_HOST=
PREGACAO_REMOTE_PORT=8883
PREGACAO_REMOTE_TLS=1
# Use o mesmo ID no PC e no celular; preservar ID existente evita mudar topics.
PREGACAO_DEVICE_ID=
PREGACAO_REMOTE_USERNAME=
PREGACAO_REMOTE_PASSWORD=
# Credencial do usuario operador no broker; separada da credencial do PC.
PREGACAO_OPERATOR_TOKEN=
PREGACAO_REMOTE_INTERVAL=10
PREGACAO_REMOTE_ENABLED=auto
